{
  "meta": {
    "name": "Blackjack",
    "players": 2,
    "turn_order": "conditional",
    "turn_rule": "if p1_standing: same_player else: same_player",
    "version": "1.0"
  },

  "board": {
    "type": "card_zones",
    "zones": [
      { "name": "deck", "visible_to": "none", "ordered": true },
      { "name": "hand_p1", "owner": "player1", "visible_to": "all", "ordered": false },
      { "name": "hand_p2", "owner": "player2", "visible_to": "all", "ordered": false },
      { "name": "hole_card", "owner": "player2", "visible_to": "owner", "ordered": false }
    ]
  },

  "cards": {
    "deck": "standard52",
    "deck_zone": "deck"
  },

  "pieces": [],

  "state_vars": [
    { "name": "p1_standing", "type": "bool", "scope": "global", "initial": false },
    { "name": "p1_bust", "type": "bool", "scope": "global", "initial": false },
    { "name": "p2_bust", "type": "bool", "scope": "global", "initial": false },
    { "name": "last_action", "type": "string", "scope": "global", "initial": "" },
    { "name": "phase", "type": "string", "scope": "global", "initial": "player" }
  ],

  "setup": [
    { "action": "shuffle", "zone": "deck" },
    { "action": "deal", "from": "deck", "to": "hand_p1", "count": 2 },
    { "action": "deal", "from": "deck", "to": "hand_p2", "count": 1 },
    { "action": "deal", "from": "deck", "to": "hole_card", "count": 1 }
  ],

  "rules": [
    {
      "name": "hit",
      "action": "draw",
      "params": [],
      "conditions": [
        "blackjack_can_hit()"
      ],
      "effects": [
        "blackjack_hit()"
      ]
    },
    {
      "name": "stand",
      "action": "stand",
      "params": [],
      "conditions": [
        "blackjack_can_stand()"
      ],
      "effects": [
        "blackjack_stand()"
      ]
    }
  ],

  "end_conditions": [
    {
      "type": "win",
      "player": "player_by_score",
      "condition": "blackjack_round_over()",
      "score": "blackjack_score(current_player)"
    }
  ],

  "_comments": {
    "rules": "Simplified Blackjack: player gets 2 cards, dealer gets 1 up + 1 face down. Player hits or stands. Then dealer reveals hole card and hits until 17+. Closest to 21 without busting wins. Face cards = 10, Ace = 1 or 11.",
    "phases": "player phase: player hits/stands. dealer phase: dealer auto-plays by house rules."
  }
}
