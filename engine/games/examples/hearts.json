{
  "meta": {
    "name": "Hearts",
    "players": 2,
    "turn_order": "conditional",
    "turn_rule": "if hearts_trick_complete(): hearts_trick_loser() else: next_player",
    "version": "1.0"
  },

  "board": {
    "type": "card_zones",
    "zones": [
      { "name": "deck", "visible_to": "none", "ordered": true },
      { "name": "hand_p1", "owner": "player1", "visible_to": "owner", "ordered": false },
      { "name": "hand_p2", "owner": "player2", "visible_to": "owner", "ordered": false },
      { "name": "trick", "visible_to": "all", "ordered": true },
      { "name": "taken_p1", "owner": "player1", "visible_to": "all", "ordered": false },
      { "name": "taken_p2", "owner": "player2", "visible_to": "all", "ordered": false }
    ]
  },

  "cards": {
    "deck": "standard52",
    "deck_zone": "deck"
  },

  "pieces": [],

  "state_vars": [
    { "name": "lead_suit", "type": "string", "scope": "global", "initial": "" },
    { "name": "lead_player", "type": "string", "scope": "global", "initial": "" },
    { "name": "hearts_broken", "type": "bool", "scope": "global", "initial": false },
    { "name": "last_action", "type": "string", "scope": "global", "initial": "" },
    { "name": "last_play", "type": "string", "scope": "global", "initial": "" },
    { "name": "p1_points", "type": "int", "scope": "global", "initial": 0 },
    { "name": "p2_points", "type": "int", "scope": "global", "initial": 0 },
    { "name": "tricks_played", "type": "int", "scope": "global", "initial": 0 },
    { "name": "trick_winner", "type": "string", "scope": "global", "initial": "" }
  ],

  "setup": [
    { "action": "shuffle", "zone": "deck" },
    { "action": "deal", "from": "deck", "to": "hand_p1", "count": 13 },
    { "action": "deal", "from": "deck", "to": "hand_p2", "count": 13 }
  ],

  "rules": [
    {
      "name": "play_card",
      "action": "play",
      "params": [
        { "name": "card_id", "select": "hearts_playable" }
      ],
      "conditions": [],
      "effects": [
        "hearts_play(card_id)"
      ]
    }
  ],

  "end_conditions": [
    {
      "type": "win",
      "player": "player_by_score",
      "condition": "hearts_game_over()",
      "score": "hearts_score(current_player)"
    }
  ],

  "_comments": {
    "rules": "Simplified 2-player Hearts: 13 cards each, no passing. Must follow lead suit if possible. Hearts = 1 point each, Queen of Spades = 13 points. Lowest points wins. Hearts can't be led until broken. 2 of clubs leads first trick."
  }
}
