{
  "meta": {
    "name": "Uno",
    "players": 2,
    "turn_order": "conditional",
    "turn_rule": "if uno_opponent_skipped(): same_player else: next_player",
    "version": "1.0"
  },

  "board": {
    "type": "card_zones",
    "zones": [
      { "name": "deck", "visible_to": "none", "ordered": true },
      { "name": "hand_p1", "owner": "player1", "visible_to": "owner", "ordered": false },
      { "name": "hand_p2", "owner": "player2", "visible_to": "owner", "ordered": false },
      { "name": "discard", "visible_to": "all", "ordered": true }
    ]
  },

  "cards": {
    "deck": "uno",
    "deck_zone": "deck"
  },

  "pieces": [],

  "state_vars": [
    { "name": "active_color", "type": "string", "scope": "global", "initial": "" },
    { "name": "last_play", "type": "string", "scope": "global", "initial": "" },
    { "name": "last_action", "type": "string", "scope": "global", "initial": "" },
    { "name": "draw_penalty", "type": "int", "scope": "global", "initial": 0 }
  ],

  "setup": [
    { "action": "shuffle", "zone": "deck" },
    { "action": "deal", "from": "deck", "to": "hand_p1", "count": 7 },
    { "action": "deal", "from": "deck", "to": "hand_p2", "count": 7 },
    { "action": "reveal", "from": "deck", "to": "discard", "count": 1 }
  ],

  "rules": [
    {
      "name": "play_card",
      "action": "play",
      "params": [
        { "name": "card_id", "select": "uno_playable" }
      ],
      "conditions": [],
      "effects": [
        "uno_play(card_id)"
      ]
    },
    {
      "name": "draw_card",
      "action": "draw",
      "params": [],
      "conditions": [
        "uno_must_draw()"
      ],
      "effects": [
        "uno_draw()"
      ]
    }
  ],

  "end_conditions": [
    {
      "type": "win",
      "player": "current_player",
      "condition": "crazy_eights_hand_empty(current_player)"
    },
    {
      "type": "win",
      "player": "player_by_score",
      "condition": "crazy_eights_deck_empty()",
      "score": "crazy_eights_score(current_player)"
    }
  ],

  "_comments": {
    "rules": "Uno: match the discard pile by color or number. Action cards: Skip (opponent loses turn), Draw Two (opponent draws 2). Wild cards match anything and let you choose the color. First to empty hand wins."
  }
}
