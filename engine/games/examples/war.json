{
  "meta": {
    "name": "War",
    "players": 2,
    "turn_order": "alternating",
    "version": "1.0"
  },

  "board": {
    "type": "card_zones",
    "zones": [
      { "name": "deck", "visible_to": "none", "ordered": true },
      { "name": "hand_p1", "owner": "player1", "visible_to": "none", "ordered": true },
      { "name": "hand_p2", "owner": "player2", "visible_to": "none", "ordered": true },
      { "name": "table", "visible_to": "all" }
    ]
  },

  "cards": {
    "deck": "standard52",
    "deck_zone": "deck"
  },

  "pieces": [],

  "state_vars": [
    { "name": "last_p1_card", "type": "string", "scope": "global", "initial": "" },
    { "name": "last_p2_card", "type": "string", "scope": "global", "initial": "" },
    { "name": "round_winner", "type": "string", "scope": "global", "initial": "" }
  ],

  "setup": [
    { "action": "shuffle", "zone": "deck" },
    { "action": "deal", "from": "deck", "to": "hand_p1", "count": 26 },
    { "action": "deal", "from": "deck", "to": "hand_p2", "count": 26 }
  ],

  "rules": [
    {
      "name": "battle",
      "action": "chance",
      "chance": true,
      "params": [],
      "conditions": [],
      "effects": [
        "war_battle()"
      ]
    }
  ],

  "end_conditions": [
    {
      "type": "win",
      "player": "player1",
      "condition": "zone_empty(\"hand_p2\")"
    },
    {
      "type": "win",
      "player": "player2",
      "condition": "zone_empty(\"hand_p1\")"
    }
  ],

  "_comments": {
    "rules": "War is a chance game — each round both players flip their top card. Higher rank wins both cards. On ties, 3 face-down + 1 flip decides.",
    "war_battle": "Built-in effect that handles the full battle logic including tie-breaking wars.",
    "zones": "Cards in hands are face-down (visible_to: none). The table shows flipped cards."
  }
}
